# Configuración General
PROJECT_NAME="Intranet Corporativa Premium"
ENVIRONMENT=development
PORT=8000

# Base de Datos
# Dejar vacío para usar SQLite (desarrollo rápido) o especificar PostgreSQL
DATABASE_URL=sqlite:///intranet.db
# DATABASE_URL=postgresql://postgres:postgres_secure_pass@db:5432/intranet_db

# Seguridad
# Cambiar en producción con claves seguras generadas
SECRET_KEY=9a8b7c6d5e4f3g2h1i0j_intranet_jwt_secret_super_key_12345
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Clave AES-256 para encriptar contraseñas del Password Manager (Debe ser de 32 bytes o una frase robusta de derivación)
# Puedes generar una clave en Python con: secrets.token_urlsafe(32)
AES_SECRET_KEY=wG5kM9sB4uD1xF7tP2zH8vC3qR0jA6eN1yI4mK7sQ9o=

# Redis & Celery
REDIS_URL=redis://localhost:6379/0
# REDIS_URL=redis://redis:6379/0

# Administrador Inicial
INITIAL_ADMIN_EMAIL=admin@intranet.local
INITIAL_ADMIN_PASSWORD=Admin12345!

# Correo institucional (configure las credenciales del buzón no-reply en cada entorno)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=no-reply@geimser.cl
SMTP_PASSWORD=
SMTP_SENDER=no-reply@geimser.cl
SMTP_FROM_NAME="GEIMSER Intranet"
APP_BASE_URL=https://intranet.geimser.cl
